# Required
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here

# Current, configurable Gemini models. The supplied project document used 1.5 Flash/Pro.
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.8-flash

# Image backend: hf_api or local_diffusers
IMAGE_PROVIDER=hf_api
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
LOCAL_IMAGE_MODEL=runwayml/stable-diffusion-v1-5

# App settings
PANEL_COUNT=5
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
IMAGE_STEPS=20
MAX_STORY_PROMPT_CHARS=2000
